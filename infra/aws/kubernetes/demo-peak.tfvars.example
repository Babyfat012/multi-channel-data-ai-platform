# Paired with the 8 vCPU Data Platform preset: 16 vCPU/64 GiB total; one worker, no workload HA yet.
region              = "ap-southeast-2"
name_prefix         = "platform"
data_platform_state = "../terraform/terraform.tfstate"
node_instance_types = ["m6i.2xlarge"]
node_desired_size   = 1
node_min_size       = 0
node_max_size       = 1
node_disk_gb        = 80
# Keep node updates from exceeding the 16 vCPU quota; accept downtime while the worker is replaced.
node_update_strategy = "MINIMAL"
single_az_workers    = true
# Fill in a standard-support EKS version, the IAM role ARN and the real admin CIDR before plan.
# kubernetes_version = "..."
# admin_role_arn     = "arn:aws:iam::ACCOUNT:role/PATH/ROLE"
# api_allowed_cidrs  = ["ADMIN_IP/32"]
