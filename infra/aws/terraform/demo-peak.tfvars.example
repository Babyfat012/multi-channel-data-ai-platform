# Preset for review: Sydney, 8 vCPU/32 GiB Data Platform. Not an authorization to apply or a cost commitment.
region                     = "ap-southeast-2"
availability_zone          = "ap-southeast-2a"
secondary_availability_zone = "ap-southeast-2b"
instance_type              = "m6i.2xlarge"
enable_ecr                 = true
enable_kubernetes_network  = true
boot_disk_gb               = 30
data_disk_gb               = 100
enable_budget              = true
budget_amount_usd          = 60
# Fill in the SSH PUBLIC key and email before plan. The budget only alerts; it does not stop resources.
# ssh_public_key = "ssh-ed25519 ..."
# budget_email   = "your-email@example.com"
