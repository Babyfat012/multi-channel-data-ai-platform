{
 "uid": "platform-agents",
 "title": "Agents, LLM, MCP",
 "schemaVersion": 39,
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "type": "row",
   "title": "LLM (qua agentgateway)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "stat",
   "title": "Total LLM requests",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(agentgateway_gen_ai_client_token_usage_count{gen_ai_token_type=\"input\"})"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Token input / request (TB)",
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(agentgateway_gen_ai_client_token_usage_sum{gen_ai_token_type=\"input\"}) / sum(agentgateway_gen_ai_client_token_usage_count{gen_ai_token_type=\"input\"})"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Token output / request (TB)",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(agentgateway_gen_ai_client_token_usage_sum{gen_ai_token_type=\"output\"}) / sum(agentgateway_gen_ai_client_token_usage_count{gen_ai_token_type=\"output\"})"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Total tokens",
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(agentgateway_gen_ai_client_token_usage_sum)"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Tokens/s by type",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (gen_ai_token_type) (rate(agentgateway_gen_ai_client_token_usage_sum[5m]))",
     "legendFormat": "{{gen_ai_token_type}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "LLM turn time (round-trip)",
