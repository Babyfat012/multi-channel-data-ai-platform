# Separate Flink 2.2 cluster for ML stream features (PyFlink + Feast). Split from the Data Platform's 1.20 cluster:
# PyFlink 1.20 pulls apache-beam < 2.49 (numpy < 1.25), which cannot be installed alongside Feast 0.66 (numpy >= 2).
FROM flink:2.2.1-java17
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
    && ln -sfn /usr/bin/python3 /usr/bin/python && rm -rf /var/lib/apt/lists/*
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN pip install --no-cache-dir "apache-flink==2.2.1" "feast[redis,aws]==0.66.0" "pytest==8.4.2"
RUN wget -q -P /opt/flink/lib \
    https://repo.maven.apache.org/maven2/org/apache/flink/flink-sql-connector-kafka/5.0.0-2.2/flink-sql-connector-kafka-5.0.0-2.2.jar
COPY feature_repo /opt/feature_repo
COPY flink_jobs/ml /opt/flink/jobs/ml
ENV FEAST_REPO_PATH=/opt/feature_repo
USER flink
