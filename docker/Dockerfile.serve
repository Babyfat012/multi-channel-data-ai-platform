# KServe return-risk predictor, model-inside-image: the model file is baked into the image, not downloaded at runtime.
# Built on platform-train (already has LightGBM + Feast + ml/) to share layers. The build context is
# assembled by scripts/run/deploy_return_risk.sh: ml/ + model.lgb downloaded from the MLflow production alias.
ARG BASE_IMAGE=platform-train:0.1.0
FROM ${BASE_IMAGE}
USER root
RUN pip install --no-cache-dir "kserve==0.21.0"
ARG MODEL_VERSION=unknown
COPY ml /opt/ml/ml
COPY feature_repo /opt/feature_repo
COPY model.lgb /opt/model/model.lgb
ENV MODEL_VERSION=${MODEL_VERSION} MODEL_PATH=/opt/model/model.lgb
ENV PYTHONPATH=/opt:/opt/ml
USER 65534
ENTRYPOINT ["python", "-m", "ml.serve"]
