# Web API that fetches features + RAG chunks (serving/app.py). Built on the existing Feast image to share the feast layer
# (saves ~1 GB of disk); build platform-feast:0.66.0 first (docker/Dockerfile.feast).
FROM platform-feast:0.66.0
USER root
RUN pip install --no-cache-dir "fastapi==0.156.4" "uvicorn==0.54.0" "mcp==2.3.0" \
    "feast[postgres]==0.66.0" "fastembed==0.8.1"
# The embedding model is baked into the image: pods start without downloading from Hugging Face.
ENV RAG_MODEL_CACHE=/opt/models
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5', cache_dir='/opt/models')" \
    && chmod -R a+rX /opt/models
COPY rag/__init__.py rag/chunking.py rag/pipeline.py /opt/rag/
COPY rag/feature_repo /opt/rag/feature_repo
COPY serving/app.py /opt/serving/app.py
COPY feature_repo /opt/feature_repo
WORKDIR /opt
ENV FEAST_REPO_PATH=/opt/feature_repo
USER 65534
EXPOSE 8000
CMD ["uvicorn", "serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
