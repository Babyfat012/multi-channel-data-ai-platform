# Unoptimized image, only for measuring size against the Dockerfile at the repo root (see docs/Docker.md).
# Single stage, full base image, pip keeps its cache, copies the whole repo.
# Libraries are installed from requirements.lock (exported from uv.lock, same versions and hashes) so both images have
# the SAME library set; they differ only in build technique. The project is installed afterwards with --no-deps so pip does not
# re-pick library versions on its own.
FROM python:3.12
WORKDIR /app
COPY . .
RUN pip install -r requirements.lock && pip install --no-deps .
ENTRYPOINT ["python", "-m", "generator"]
