# Copy to .env and change the values. .env is not committed.
MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=sources
# Generator config run in Compose: configs/small.yaml or configs/default.yaml
GENERATOR_CONFIG=configs/small.yaml
# Ports exposed on the host; change them if another program already uses them
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
KAFKA_PORT=9094
# Stream replay speed: 1 is real time (about 40 minutes for 30 days), 60 is 60x faster
STREAM_SPEED=1
# Spark (spark profile). Lower SPARK_WORKER_MEMORY to 1g when running alongside Airflow to ease RAM pressure
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_MEM_LIMIT=2560m
SPARK_WORKER_CORES=2
SPARK_MASTER_PORT=7077
SPARK_UI_PORT=8080
# Lakekeeper (catalog/spark profile): key that encrypts secrets in the catalog DB; change it to your own string
LAKEKEEPER_ENCRYPTION_KEY=change-me-lakekeeper-key
LAKEKEEPER_PORT=8181
# Airflow (airflow profile). The UID needs write access to out/spark-events on the host.
AIRFLOW_UID=1000
AIRFLOW_WEB_PORT=8081
# Trino (profile query). JDBC endpoint for DBeaver: localhost:8083
TRINO_PORT=8083
# Debezium Kafka Connect REST (profile cdc)
DEBEZIUM_PORT=8084
# Kafka UI (cdc profile) — browse CDC topics and connector status
KAFKA_UI_PORT=8085
# DataHub (runs outside Compose via `datahub docker quickstart`).
# GMS must move off port 8080 because the Spark UI uses that port.
DATAHUB_GMS_URL=http://localhost:8089
DATAHUB_MAPPED_GMS_PORT=8089
DATAHUB_MAPPED_FRONTEND_PORT=9002
# MLflow UI (profile ml): http://localhost:5050
MLFLOW_PORT=5050
# Vault (profile security): http://localhost:8200
VAULT_PORT=8200
